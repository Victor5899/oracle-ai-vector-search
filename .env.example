# Local development only. Copy to .env and fill in values.
# Do not commit .env or the Oracle wallet.
# Production hosts set these same names in the environment.
# A local .env file does not override variables that are already set.

# Oracle Autonomous AI Database (python-oracledb thin mode, mTLS wallet)
DB_USER=
DB_PASSWORD=
DB_DSN=
WALLET_DIR=
WALLET_PASSWORD=

# Answer generation
OPENAI_API_KEY=
OPENAI_MODEL=

# Comma-separated browser origins allowed to call the API.
# Use the deployed frontend origin. Do not use *.
# Leave blank for local development; the Vite proxy is same-origin.
# CORS_ORIGINS=https://your-frontend.example
CORS_ORIGINS=
