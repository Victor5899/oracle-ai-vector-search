# Base URL the browser uses to reach the FastAPI backend.
#
# Example:
#   VITE_API_BASE_URL=http://localhost:8000
#
# Leave this blank for local development. The client then calls a relative
# /api path and the Vite dev server proxies it to VITE_PROXY_TARGET, so the
# request stays same-origin. An absolute URL is only needed when the frontend
# is served from a different origin than the API and that origin is allowed.
VITE_API_BASE_URL=

# Where the dev server forwards /api requests. Development only; this value is
# never bundled into the production build.
VITE_PROXY_TARGET=http://localhost:8000
