# Base URL the browser uses to reach the FastAPI backend.
#
# Production (Vercel): set this at build time to the deployed API origin,
# with no path and no trailing slash, for example:
#   VITE_API_BASE_URL=https://your-api.example
# The API must list that Vercel origin in CORS_ORIGINS.
#
# Local development: leave this blank. The client then calls a relative
# /api path and the Vite dev server proxies it to VITE_PROXY_TARGET, so the
# request stays same-origin.
VITE_API_BASE_URL=

# Where the dev server forwards /api requests. Development only; this value is
# never bundled into the production build.
VITE_PROXY_TARGET=http://localhost:8000
